#!/usr/bin/env bash
# Verify APK signature integrity with Android SDK Build Tools' apksigner.
# apksigner exits non-zero on any signature ERROR; -Werr is deliberately NOT
# used because real AGP-built APKs carry informational warnings (META-INF
# metadata/version entries covered by the v2 scheme, not v1) that -Werr
# escalates to a false refusal of a validly signed APK.
set -euo pipefail

if [[ "$#" -ne 1 || ! -f "$1" ]]; then
    echo "micsource-apk-verify: expected one existing APK path." >&2
    exit 2
fi

DATA_DIR="${HOME}/.local/share/micsource"
SDK_HOME="${ANDROID_HOME:-}"
JAVA_HOME_TOOL="${JAVA_HOME:-}"
if [[ -f "${DATA_DIR}/build-env.path" ]]; then
    while IFS='=' read -r key value; do
        case "${key}" in
        ANDROID_HOME) SDK_HOME="${value}" ;;
        JAVA_HOME) JAVA_HOME_TOOL="${value}" ;;
        esac
    done <"${DATA_DIR}/build-env.path"
fi
if [[ -n "${JAVA_HOME_TOOL}" && -x "${JAVA_HOME_TOOL}/bin/java" ]]; then
    export PATH="${JAVA_HOME_TOOL}/bin:${PATH}"
fi

if [[ -z "${SDK_HOME}" && -f "${DATA_DIR}/project.path" ]]; then
    PROJECT_ROOT="$(tr -d '\n' <"${DATA_DIR}/project.path")"
    if [[ -f "${PROJECT_ROOT}/local.properties" ]]; then
        while IFS='=' read -r key value; do
            [[ "${key}" == sdk.dir ]] && SDK_HOME="${value}"
        done <"${PROJECT_ROOT}/local.properties"
    fi
fi

APKSIGNER=""
if [[ -n "${SDK_HOME}" ]]; then
    for candidate in "${SDK_HOME}"/build-tools/*/apksigner; do
        if [[ -x "${candidate}" ]]; then
            APKSIGNER="${candidate}"
        fi
    done
fi
if [[ -z "${APKSIGNER}" ]]; then
    APKSIGNER="$(command -v apksigner || true)"
fi
if [[ -z "${APKSIGNER}" || ! -x "${APKSIGNER}" ]]; then
    echo "micsource-apk-verify: apksigner not found; install Android SDK Build-Tools or add apksigner to PATH." >&2
    exit 1
fi

if ! "${APKSIGNER}" verify --verbose --print-certs "$1"; then
    echo "micsource-apk-verify: APK signature verification failed: $1" >&2
    exit 1
fi
